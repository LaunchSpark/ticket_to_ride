# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.env/
.venv/
.uv-cache/
env/


# IDE and editor settings (optional, but common)
.vscode/
.idea/
*.swp
*.swo
*.bak
*.tmp
.DS_Store

# Example / donor websites
/example_webpage/

# Logs and databases
*.log

# Local PocketBase runtime data
operations/data/pocketbase/backups/
operations/data/pocketbase/*.db
operations/data/pocketbase/*.db-shm
operations/data/pocketbase/*.db-wal

# marimo per-notebook session cache
**/__marimo__/

# Build-only tool for the notebook harness's vendored graph widget - the
# bundled build/ output it produces is committed under
# applications/notebook_harness/static/, so this doesn't need to ship.
applications/notebook_harness/widget-src/node_modules/
.claude/settings.json
operations/tools/pocketbase/pocketbase
operations/data/pb_migrations/
operations/research/results/
